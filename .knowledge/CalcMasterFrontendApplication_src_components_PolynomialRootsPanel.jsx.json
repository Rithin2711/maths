{"is_source_file": true, "format": "JavaScript (React JSX)", "description": "This file defines a React component 'PolynomialRootsPanel' that provides a user interface for inputting a polynomial, computing its roots (both symbolic and numeric), and visualizing the polynomial function along with its roots on a graph. It includes utility functions for parsing polynomial expressions, evaluating polynomials, and plotting the function using Plotly.", "external_files": ["./PlotlyLite"], "external_methods": ["PlotlyLite"], "published": ["PolynomialRootsPanel"], "classes": [], "methods": [{"name": "parsePolynomialToCoeffs(exprRaw)", "description": "Parses a polynomial expression string into an array of coefficients from highest to lowest degree. Supports inputs like 'x^3 - 6x^2 + 11x - 6' or comma-separated coefficients '1,-6,11,-6'. Returns null if parsing fails.", "scope": "", "scopeKind": ""}, {"name": "evalPolynomialAt(coeffsDesc, x)", "description": "Evaluates a polynomial at a given value x using Horner's method, given the coefficients array.", "scope": "", "scopeKind": ""}, {"name": "formatComplex({ re, im }, precision = 10)", "description": "Formats a complex number object with real and imaginary parts into a string, with specified precision.", "scope": "", "scopeKind": ""}, {"name": "rootsSymbolicLatex(expr)", "description": "Uses nerdamer to compute the roots of the polynomial symbolically and returns the roots in LaTeX format along with raw roots data.", "scope": "", "scopeKind": ""}, {"name": "PolynomialRootsPanel({ onBack })", "description": "React component providing UI for polynomial input, root computation (symbolic and numeric), and plotting the polynomial with roots visually marked.", "scope": "", "scopeKind": ""}], "calls": ["PropTypes", "PlotlyLite", "nerdamer", "nerdamer.Algebra", "nerdamer.Solve", "rootsSymbolicLatex", "parsePolynomialToCoeffs", "evalPolynomialAt", "formatComplex"], "search-terms": ["PolynomialRootsPanel", "parsePolynomialToCoeffs", "ro